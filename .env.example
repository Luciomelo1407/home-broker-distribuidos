# Copie para .env (cp .env.example .env). O .env não é versionado.
# Os valores abaixo servem só para desenvolvimento local.

# --- Postgres (fonte da verdade) ---
POSTGRES_DB=bolsa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev
# Porta exposta só em 127.0.0.1, para rodar apps e testes fora do Docker
POSTGRES_PORT=5432

# Papéis criados por db/init (0003_grants.sql define o que cada um pode fazer)
ENGINE_DB_PASSWORD=engine_dev
GATEWAY_DB_PASSWORD=gateway_dev

# URLs para rodar os apps fora do Docker (dentro do compose o host é "postgres"/"redis")
ENGINE_DATABASE_URL=postgres://engine_app:engine_dev@localhost:5432/bolsa
GATEWAY_DATABASE_URL=postgres://gateway_app:gateway_dev@localhost:5432/bolsa

# --- Redis (stream de ordens, Pub/Sub, presença) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Gateway ---
GATEWAY_PORT=3001
# fatal | error | warn | info | debug | trace | silent (debug só fora da demo)
LOG_LEVEL=info
JWT_SECRET=troque-este-segredo-em-producao
# SD-04: validade do token e timeout de confirmação da ordem
JWT_EXPIRACAO=8h
ORDEM_TIMEOUT_MS=3000

# --- Home Broker ---
WEB_PORT=3000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001

# --- Regras iniciais do mercado (S-01) ---
SALDO_INICIAL=100000.00
ACOES_INICIAIS=1000
